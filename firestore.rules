rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity test check
    match /test/{docId} {
      allow read: if true;
    }

    // User Profile: contains plan, question quotas, timestamps
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.plan in ['free', 'pro'];
      allow update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if false;

      // User Chats: synced across devices
      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(chatId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId)
          && isValidId(chatId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(chatId);
      }

      // User Settings: theme, font size, response style, madhhab
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
